# LibreBooking
LIBREBOOKING_URL=https://booking.example.com
LIBREBOOKING_USERNAME=svc-zaptec
LIBREBOOKING_PASSWORD=change-me

# How the Zaptec RFID token is stored on the LibreBooking user:
#   custom_attribute -> value in custom attribute RFID_CUSTOM_ATTRIBUTE_ID (attN)
#   phone            -> value in the user's phoneNumber field
RFID_MAPPING=custom_attribute
RFID_CUSTOM_ATTRIBUTE_ID=1

# Authorization window around the booked time (minutes)
GRACE_MINUTES_BEFORE=15
GRACE_MINUTES_AFTER=60

# Optional: Zaptec chargerId or installationId (UUID) -> LibreBooking resourceId
# CHARGER_RESOURCE_MAP=b7f0c79c-0a76-4b87-a469-90d91e3ac901:12,4adc8954-274b-4acd-a2e3-3a31567565e9:12
REQUIRE_ACTIVE_RESERVATION=true

# ZapCloud -> middleware authentication (leave both empty only if protected by
# a reverse proxy / mTLS / IP allowlist)
ZAPTEC_BASIC_USERNAME=zapuser
ZAPTEC_BASIC_PASSWORD=change-me
# ZAPTEC_BEARER_TOKEN=

# Restrict to specific Zaptec installations (comma-separated UUIDs); empty = all
# ALLOWED_INSTALLATION_IDS=4adc8954-274b-4acd-a2e3-3a31567565e9
